<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <include layout="@layout/include_header" android:id="@+id/header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Clasificación -->
        <TextView
            android:text="Clasificación:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spClasificacionEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Nombre -->
        <TextView
            android:text="Nombre de unidad:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etNombreUnidadEdit"
            android:hint="Nombre actual"
            android:inputType="textCapWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Ocupantes -->
        <TextView
            android:text="Cantidad de ocupantes:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etCantidadOcupantesEdit"
            android:hint="0"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Tipo documento -->
        <TextView
            android:text="Tipo documento:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spTipoDocumentoEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Documento -->
        <TextView
            android:text="Documento:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etDocumentoEdit"
            android:hint="Documento actual"
            android:inputType="textCapCharacters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Nombres -->
        <TextView
            android:text="Nombres ocupante:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etNombresOcupanteEdit"
            android:hint="Nombres actuales"
            android:inputType="textCapWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Apellidos -->
        <TextView
            android:text="Apellidos ocupante:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etApellidosOcupanteEdit"
            android:hint="Apellidos actuales"
            android:inputType="textCapWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Teléfono -->
        <TextView
            android:text="Teléfono:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etTelefonoEdi"
            android:hint="Teléfono actual"
            android:inputType="phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Correo -->
        <TextView
            android:text="Correo:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etCorreoEdi"
            android:hint="Correo actual"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Medidor -->
        <TextView
            android:text="Medidor asociado:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etMedidorEdi"
            android:hint="Identificador actual"
            android:inputType="textCapCharacters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="12dp"/>

        <!-- Lectura Inicial -->
        <TextView
            android:text="Lectura inicial:"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etLecturaInicialEdi"
            android:hint="Valor actual"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="24dp"/>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btnGuardarCambio"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@android:color/white"/>
    </LinearLayout>
    </ScrollView>

    <!-- FOOTER FIJO -->
    <include layout="@layout/include_footer" android:id="@+id/footer"/>
</LinearLayout>