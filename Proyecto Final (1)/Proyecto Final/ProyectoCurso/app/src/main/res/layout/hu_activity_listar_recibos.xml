<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".HU_ListarRecibosActivity">

    <!-- Header fijo -->
    <include
        android:id="@+id/header"
        layout="@layout/include_header" />

    <!-- Contenido fijo superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra el consumo total de tu recibo, según tu predio."
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="12dp"/>

        <!-- Selector de Predio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECCIONA TU PREDIO:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_predio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/recibo_spinner_predios"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Servicios encontrados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/recibo_ic_flash"
                android:background="@color/primary_blue"
                android:contentDescription="Luz" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servicios encontrados"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_servicio_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luz"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- Texto "Mis últimos registros" + botón "Nuevo" en la misma fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mis últimos registros"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/btn_nuevo_recibo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo"
                android:textSize="13sp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
    <Button
        android:id="@+id/btnIrCalculos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ir a mis cálculos"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/primary_blue"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:paddingVertical="10dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical" />

    <!-- RecyclerView scrollable -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recibos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/hu_item_lista_recibos" />

    <!-- Footer fijo -->
    <include
        android:id="@+id/footer"
        layout="@layout/include_footer" />

</LinearLayout>
