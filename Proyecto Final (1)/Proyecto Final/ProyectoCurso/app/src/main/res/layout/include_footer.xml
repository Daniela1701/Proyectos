<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#E6EFFF"
    android:weightSum="3"
    android:elevation="4dp"
    android:paddingVertical="6dp">

    <!-- 🔹 BOTÓN 1: INICIO -->

    <!-- 🔹 BOTÓN 2: CONSUMOS -->
    <LinearLayout
        android:id="@+id/btnInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconInicio"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/footer_ic_home"
            app:tint="#757575" />

        <TextView
            android:id="@+id/txtInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio"
            android:textColor="#757575"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnConsumos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconConsumos"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/dash_ic_indicador"
            app:tint="#757575" />

        <TextView
            android:id="@+id/txtConsumos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consumos"
            android:textColor="#757575"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 🔹 BOTÓN 3: FACTURAS -->
    <LinearLayout
        android:id="@+id/btnFacturas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconFacturas"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/dash_ic_recibos"
            app:tint="#757575" />

        <TextView
            android:id="@+id/txtFacturas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Facturas"
            android:textColor="#757575"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
