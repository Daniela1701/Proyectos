<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!--  ENCABEZADO -->
    <include
        android:id="@+id/header"
        layout="@layout/include_header" />

    <!--  CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/lectura_contorno"
            android:padding="16dp"
            android:elevation="2dp">

            <!-- ICONO Y TÍTULO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/lectura_icon_circle"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/icTipoLectura"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/lectura_ic_detail"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTituloDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lectura del 30/09/2025 - 10:30 am"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <!-- Tipo de Lectura -->
                <TextView
                    android:id="@+id/tvTipoLecturaDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de lectura: TIPO"
                    android:textColor="#5A5A5A"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!--  DETALLES -->
            <TextView
                android:id="@+id/tvValorDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor: 00.00 kWh"
                android:textSize="17sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUnidadDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unidad: Dpto nro"
                android:textSize="17sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPredioDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Predio: Nombre predio"
                android:textSize="17sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNotasDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas: Comentarios"
                android:textSize="17sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <!--  FOTO DE LA LECTURA (solo si existe) -->
            <ImageView
                android:id="@+id/imgLecturaFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:layout_marginTop="10dp"
                android:background="#EAEAEA"
                android:visibility="gone"
                android:contentDescription="Foto de la lectura" />

            <!-- BOTÓN VOLVER -->
            <Button
                android:id="@+id/btnVolverDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Volver"
                android:textAllCaps="false"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:paddingVertical="10dp" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/footer"
        layout="@layout/include_footer" />

</LinearLayout>
