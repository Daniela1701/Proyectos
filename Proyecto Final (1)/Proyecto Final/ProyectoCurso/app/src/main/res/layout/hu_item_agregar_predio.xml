<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/predio_card_add"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Icono del predio -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/predio_apartment_24"
        android:background="@drawable/predio_circle_gray"
        android:padding="8dp"
        android:contentDescription="Icono Predio" />

    <!-- Información del card -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Predio"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección:"
            android:textSize="14sp"
            android:textColor="#B0B0B0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servicio:"
            android:textSize="14sp"
            android:textColor="#B0B0B0" />
    </LinearLayout>

    <!-- Botón de agregar -->
    <ImageButton
        android:id="@+id/btnAgregarPredio"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/predio_add"
        app:tint="#888888"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Agregar Predio" />
</LinearLayout>
